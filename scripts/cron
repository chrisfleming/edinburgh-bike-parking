SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin:/home/chrisfl/.asdf/shims/

# Edinburgh bike parking — pull, fetch, regenerate, deploy if changed (4x daily)
0 */6 * * * chrisfl cd /home/chrisfl/projects/edinburgh-bike-parking/ && git pull && before=$(cat web/data/*.geojson | sha256sum) && bash update_data_and_regenerate.sh && after=$(cat web/data/*.geojson | sha256sum) && [ "$before" != "$after" ] && bash deploy.sh >> /var/log/processing/osm-bike-parking.log 2>&1
